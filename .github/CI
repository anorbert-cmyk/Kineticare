# ============================================================================
# Kineticare – CI (minőségi kapuk, G0)
# ----------------------------------------------------------------------------
# Minden main-push és PR lefuttatja:
#   verify job : npm install -> typecheck -> vitest -> eslint
#   build  job : next build (DUMMY-envvel, explicit jelölve)
#   audit  job : npm audit (moderate+ = bukás)
# A package-lock.json landolása után az install-lépés npm ci-re vált
# (a megjegyzés-jelölőt cseréld le — egy soros módosítás).
# Deploy NEM a CI része – a Railway-deploy külön döntés tárgya.
# ============================================================================

name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}

env:
  NODE_VERSION: "20"

jobs:
  verify:
    name: typecheck + vitest + lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm

      # LOCKFILE-VÁLTÁS: a package-lock.json repóba kerülése után ez a sor
      # legyen:  npm ci
      - name: Függőségek telepítése
        run: npm install --no-audit --no-fund

      - name: Typecheck
        run: npx tsc --noEmit

      - name: Vitest
        run: npx vitest run

      - name: ESLint
        run: npm run lint

  build:
    name: next build
    runs-on: ubuntu-latest
    needs: verify
    env:
      # DUMMY értékek — explicit jelölve, NEM valódi titkok. Az induláskori
      # ENV-assert miatt kellenek; semmilyen valódi rendszerhez nem kapcsolódnak.
      DATABASE_URI: postgresql://dummy:dummy@localhost:5432/dummy
      PAYLOAD_SECRET: DUMMY-PAYLOAD-SECRET-NEM-VALODI-TITOK
      NEXT_PUBLIC_SERVER_URL: http://localhost:3000
      BARION_API_URL: https://api.test.barion.com
      BARION_PAYEE_EMAIL: dummy-payee@example.test
      BARION_POSKEY_TEST: DUMMY-POSKEY-NEM-VALODI-TITOK
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm

      # LOCKFILE-VÁLTÁS: lásd a verify job megjegyzését.
      - name: Függőségek telepítése
        run: npm install --no-audit --no-fund

      - name: Build
        run: npm run build

  # OWASP-ajánlás (docs/owasp-security-review.md GREEN#3): a dependency-audit
  # minden push/PR során — moderate+ sérülékenység = bukás. A build-hiba nem
  # blokkolja az auditot és fordítva (needs-mentes).
  audit:
    name: npm audit (moderate+ = bukás)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm
      - run: npm install --no-audit --no-fund
      - run: npm audit --audit-level=moderate
