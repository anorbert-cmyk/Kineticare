# dependencies
/node_modules

# next.js
/.next/
/out/

# production build output
/dist
/build

# test coverage
/coverage

# környezeti változók — titkok sosem kerülhetnek a repóba
# (a mintafájlok — .env.example és társai — a kivétel: azok verziózandók)
.env*
!.env.example
!.env.*.example

# typescript
*.tsbuildinfo

# misc
.DS_Store

# ügynök-munkakönyvtár (worktree-k, munkamenet-szintű állapot) — sosem verziózandó.
# KIVÉTEL a `.claude/skills/`: a projekt-skillek a repó részei (a tulajdonos
# 2026-08-16-i döntése), különben minden új munkamenetben elvesznének.
.claude/*
!.claude/skills/

# ügynök-eszközök, amiket külső telepítő tesz a repó gyökerébe (npx skills add).
# Munkamenetenként/gépenként eltérnek, nem a projekt kódja.
.agents/
skills-lock.json

# Adatbázis-mentések (npm run backup:db alapértelmezett célkönyvtára).
# A dump a TELJES adatbázist tartalmazza (személyes adat, jelszó-hash) —
# sosem kerülhet a repóba. Lásd docs/adatbazis-mentes.md.
/backups/

# Payload upload-mappa (Media collection staticDir) — futásidejű adat, nem forrás.
# Helyi seed-futás is ide tölt; élesben a kötet/volume tartalma, sosem verziózandó.
/media/
