# A @payloadcms/* 3.86.0 peer-tartomanya jelenleg `next <15.5.0`,
# a repo viszont a biztonsagi javitas miatt next@15.5.22-re van pinelve.
# Amig a Payload ki nem adja a 15.5.x-et engedo peer-range-et (kormanyzott
# @payloadcms bump a backlogban), a telepites csak legacy-peer-deps-szel
# oldhato fel. Ez a flag minden npm-nel futtatott install/ci-re ervenyes
# (Railway Nixpacks, lokalis fejlesztes, CI).
legacy-peer-deps=true
