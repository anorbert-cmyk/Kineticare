# A legacy-peer-deps flag indoka: a @payloadcms/* 3.86.0 peer-tartomanya a
# next@16.x mar engedi (`>=16.2.6 <17.0.0` — @payloadcms/next es @payloadcms/ui),
# de a lockfile meg a regebbi, szukebb tartomanyu felbontas korul alakult ki;
# a teljes, tiszta-registrys ujrageneralas kulon, emberi dontesu PR (feladatlista
# C2). Addig is a flag biztonsagi halokent marad: minden npm-folyamatra ervenyes
# (Railway Railpack, lokalis fejlesztes, CI). Ne tavolitsd el a C2 PR elott.
legacy-peer-deps=true
